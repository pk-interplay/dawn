# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Used by every API route via app/lib/db.ts, which THROWS at import if unset —
# so the app will not boot without it.
SUPABASE_PUBLISHABLE_KEY=
# Used only by the tsx scripts (src/lib/supabase.ts): npm run seed / match.
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side client (app/lib/supabase-browser.ts). Same values as above, but
# they must carry the NEXT_PUBLIC_ prefix to be inlined into the bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Auth email — Resend as Supabase's custom SMTP (npm run auth:config)
# ---------------------------------------------------------------------------
# Provisioned through the Vercel Marketplace (`vercel integration add
# resend/resend-email`), so on Vercel this arrives automatically; pull it locally
# with `vercel env pull`. Doubles as the SMTP password (user is literally "resend").
#
# Supabase's built-in mailer caps auth email at ~2/hour and can refuse anyone who
# isn't a project member — which makes password reset look broken rather than slow.
# That cap is why this exists.
RESEND_API_KEY=

# The From address on password-reset email. MUST be on a domain verified in Resend
# (Domains → Add domain, then the DNS records); Resend rejects mail from anything
# else, and Supabase surfaces that only as a generic "error sending recovery email".
AUTH_SENDER_EMAIL=
AUTH_SENDER_NAME=Dawn

# Personal access token from Supabase dashboard → Account → Access Tokens (sbp_…).
# Used ONLY by npm run auth:config, to set SMTP + the redirect allow list. Never
# shipped to the browser; leave it out of the Vercel project unless you run the
# script from CI.
SUPABASE_ACCESS_TOKEN=

# Optional wildcard so reset links work on Vercel preview deployments, which get a
# new hostname per push (e.g. https://dawn-*-pk-interplay.vercel.app/reset-password).
AUTH_PREVIEW_URL_PATTERN=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# OpenAI is embeddings only (text-embedding-3-small). If it is unset, POST
# /api/people silently skips embeddings and run-matches will skip that member
# forever with "no embeddings" — set it before onboarding anyone.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# AgentMail — agent-native email (send/receive). https://agentmail.to
# ---------------------------------------------------------------------------
# If AGENTMAIL_API_KEY is unset, src/lib/agentmail.ts runs in SIMULATED mode:
# it logs instead of sending, but the introduction state machine still advances.
# You get a full database trail of intros that were never delivered.
AGENTMAIL_API_KEY=
# The AgentMail inbox Dawn sends from / receives on (e.g. "dawnagent" or a full address).
AGENTMAIL_INBOX_ID=dawnagent@agentmail.to

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------
# Shared secret gating the /api/cron/* and /api/agent/inbound routes.
# pg_cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Unset means isAuthorized() DENIES every request — automation routes all 401.
CRON_SECRET=

# Base URL of the deployed Next.js app, used by the AgentMail webhook Edge
# Function to call back into /api/agent/inbound (e.g. https://your-app.example.com).
# While this points at localhost, no inbound reply can ever be delivered.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Testing switches — ALL must stay blank/false in production
# ---------------------------------------------------------------------------
# Sends only ONE opt-in email (to person A) and auto-opts-in person B so the
# flow can be exercised with a single real inbox.
#
# WARNING: this writes b_response='yes' at insert — recording a person as having
# consented to an introduction they were never told about. Never enable this
# once real members exist.
INTRO_TEST_SINGLE_SIDED=

# Redirects ALL outbound intro email to this one address, because seeded people
# have fake @example.com addresses that don't deliver.
#
# WARNING: leaving this set on a deployment sends every real member's
# introduction to the operator's inbox instead of to them. It is also ONE-WAY:
# replies arrive from the redirect address, which matches no `people.email`, so
# the sender can't be resolved and the introduction can never advance. To test
# the reply leg, point a person row at a real inbox instead.
#
# Superseded for the pilot by the demo cohort below: personas hold real,
# plus-addressed inboxes, so the round trip works without redirecting anything.
# Leave this BLANK while real teammates are in the network.
MAIL_REDIRECT_TO=

# ---------------------------------------------------------------------------
# Pilot: the demo cohort (see RUNBOOK.md)
# ---------------------------------------------------------------------------
# The one inbox every fictional persona delivers to — the address you read while
# playing the other side of the network. `npm run personas` gives each persona a
# plus-addressed variant of it (pk+ava.chen1@…), because people.email is unique but
# all of them have to land somewhere you can answer from.
#
# Replies work from your ordinary address: inbound triage matches the base address
# and uses the thread to tell which persona is speaking. Reply IN THE THREAD — a
# fresh email resolves to you, not to the persona.
#
# Required by the script only; the app never reads it.
DEMO_PERSONA_INBOX=

# Counterparts generated per onboarded member (default 6). They are written against
# that member's stated goals, so run the script AFTER the team has onboarded.
PERSONAS_PER_MEMBER=6

# ---------------------------------------------------------------------------
# Inbound gating
# ---------------------------------------------------------------------------
# Whether Dawn sends its templated replies to non-members (waitlist invite) and
# to out-of-scope requests. Default OFF — these are the only inbound paths that
# email people who did not opt in, so enabling is a deliberate act.
#
# Note: the unsubscribe/pause CONFIRMATION also routes through this. With it
# off, a pause is honored silently and the member gets no acknowledgement.
# Triage itself (membership check, rate limit, replay protection) is always on.
INBOUND_AUTOREPLY=false

# Max inbound messages Dawn will process per MEMBER per hour. Bounds both accidental
# email loops and the token spend one member can trigger. Counted per resolved person
# rather than per From address, so one mailbox answering for several demo personas
# isn't silenced after ten replies. Raise it (~20) while running the pilot, since you
# will be answering as several personas an hour.
INBOUND_MAX_PER_HOUR=10

# ---------------------------------------------------------------------------
# Admin access (app/lib/admin-auth.ts)
# ---------------------------------------------------------------------------
# Whole domains allowed into /admin and the monitor routes — anyone with an
# address on one of these gets in without a per-person edit. Matched on exact
# equality after the last '@', so evil-example.com and subdomains do NOT qualify.
ADMIN_EMAIL_DOMAINS=

# Individual addresses for guests outside those domains, comma-separated.
# Admin routes are closed unless at least one of these two vars is set.
ADMIN_EMAILS=
