# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Required BY THE APP, not just the scripts: app/lib/db.ts and src/lib/supabase.ts
# are both service-role clients and both THROW at import if this is unset — the
# API routes 500 on first request without it. (The publishable/anon key is dead:
# migration 0041 enabled RLS with zero policies and revoked anon grants, so it
# can read and write nothing. It is no longer used anywhere in the app.)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# OpenAI is embeddings only (text-embedding-3-small). If it is unset, POST
# /api/people silently skips embeddings and run-matches will skip that member
# forever with "no embeddings" — set it before onboarding anyone.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Exa (https://exa.ai) — company enrichment for organization entities. When a
# work-email domain crosses the people threshold, /api/cron/reconcile-companies
# calls Exa's /answer endpoint to populate the company's claims. If unset,
# reconciliation still creates the org and its `works_at` edges; it just carries
# no Exa facts (enrichCompany returns { enriched: false }).
EXA_API_KEY=

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------
# Shared secret gating the /api/cron/* routes.
# pg_cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Unset means isAuthorized() DENIES every request — automation routes all 401.
# ROTATION: this value lives in TWO places — the Vercel env and Supabase Vault
# ('dawn_cron_secret'). Rotate by updating both, then re-running
# `select schedule_dawn_jobs();` so pg_cron picks up the new header.
CRON_SECRET=

# Shared secret gating POST /api/agent/inbound (app/lib/authz.ts). The AgentMail
# webhook is configured to send it as a custom `Authorization: Bearer …` header.
# Deliberately a DIFFERENT secret from CRON_SECRET: a leaked cron secret must not
# be able to forge inbound mail, and this one rotates by updating just the Vercel
# env + the AgentMail webhook headers (no Vault, no schedule_dawn_jobs()).
# Unset means the inbound route 401s everything (deny by default).
INBOUND_WEBHOOK_SECRET=

# Base URL of the deployed Next.js app (e.g. https://your-app.example.com). Used by
# pg_cron's http_post to call back into /api/cron/*, and by auth redirects.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Pilot: the demo cohort (see RUNBOOK.md)
# ---------------------------------------------------------------------------
# Counterparts generated per onboarded member (default 6). They are written against
# that member's stated goals, so run the script AFTER the team has onboarded.
PERSONAS_PER_MEMBER=6

# ---------------------------------------------------------------------------
# Admin access (app/lib/admin-auth.ts)
# ---------------------------------------------------------------------------
# Whole domains allowed into /admin and the monitor routes — anyone with an
# address on one of these gets in without a per-person edit. Matched on exact
# equality after the last '@', so evil-example.com and subdomains do NOT qualify.
ADMIN_EMAIL_DOMAINS=

# Individual addresses for guests outside those domains, comma-separated.
# Admin routes are closed unless at least one of these two vars is set.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Sign-in (src/auth.ts + src/lib/allowlist.ts)
# ---------------------------------------------------------------------------
# Google is the only way in, and sign-in is INVITE-ONLY: the signIn callback
# denies any account matching neither list below. Both unset = nobody signs in.
#
#   ALLOWED_EMAIL_DOMAINS — Workspace domains (e.g. "interplay.vc"), verified via
#                           Google's `hd` claim, which only real Workspace accounts
#                           carry. Email-suffix lookalikes do not qualify.
#   ALLOWED_EMAILS        — individual addresses (comma-separated), the escape
#                           hatch for hand-picked members incl. personal @gmail.com.
#
# OAuth client type trade (SPEC §3.3): the Google OAuth client can stay "Internal"
# (Workspace-only — exempt from verification and CASA despite the restricted
# gmail.readonly scope) ONLY while every member is in the Interplay Workspace.
# Adding a personal-gmail member via ALLOWED_EMAILS forces the client to
# "External", which puts restricted-scope verification back on the table. Choose
# consciously.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Session encryption key for next-auth. Generate with: npx auth secret
AUTH_SECRET=

# Encrypts Google refresh tokens at rest (google_accounts.refresh_token_enc,
# AES-256-GCM in src/lib/google-token-crypto.ts). 32 bytes of base64 — generate
# with: openssl rand -base64 32. Losing/rotating it invalidates every stored
# refresh token; each member heals their own row by signing in again
# (prompt=consent reissues one on every authorization).
GOOGLE_TOKEN_ENC_KEY=

# ---------------------------------------------------------------------------
# Email — the send gateway (src/lib/send-gateway.ts, SPEC §3.2)
# ---------------------------------------------------------------------------
# THE KILL SWITCH. The only thing standing between this system and live email
# reaching real people, and the only variable in this file whose absence is
# load-bearing.
#
# Read as `=== "true"` in exactly one place. Unset, empty, "TRUE", "1", "yes",
# and typos ALL mean OFF. CI fails the build if anyone rewrites it as
# `!== "false"` — that inversion has already cost this project once, in
# isSingleSided(), where a missing variable silently marked a real human as
# having consented to an introduction nobody had asked them about.
#
# With this off, every message is still composed, given its unsubscribe footer,
# and written to the `sends` ledger as a `draft` with the exact body. Read them
# at /admin/monitor → Outbox. See RUNBOOK step 10 before switching it on.
DAWN_DELIVERY_ENABLED=

# Required once delivery is on. Without it a live deploy fails every send
# loudly (sends.failure_reason) rather than silently pretending to have sent.
AGENTMAIL_API_KEY=
# The inbox Dawn sends from and receives on. The default is written into
# existing conversations.inbox_id rows, so changing it orphans them.
AGENTMAIL_INBOX_ID=

# Testing override: deliver EVERYTHING here instead of the real recipient, with
# the intended recipient noted in the body. Personas have undeliverable
# @example.com addresses, so this is what makes the synthetic cohort usable.
MAIL_REDIRECT_TO=

# Let Dawn answer people who write in but aren't members (waitlist reply) and
# asks it can't act on (out-of-scope reply). Off by default: these are the only
# sends with no introduction behind them, authorised instead by the inbound
# message itself (sends.consent_basis = 'inbound_reply').
INBOUND_AUTOREPLY=

# Auto-opt-in person B so the double opt-in flow can reach scheduling with a
# single real inbox. Must be opted INTO — see the comment in intro-flow.ts.
INTRO_TEST_SINGLE_SIDED=
